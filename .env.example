# ---- Required ----------------------------------------------------------
# Hosted PostgreSQL (Neon, Supabase, Railway, RDS...). On Vercel use the POOLED connection string
# and add ?sslmode=require. A localhost URL only works on your own machine.
DATABASE_URL="postgresql://username:password@host:5432/vanigam?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the site (on Vercel: https://your-domain.com)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
SITE_NAME="Vanigam Commerce"

# ---- Product image uploads (required on Vercel: its filesystem is read-only) ----
# Either one URL...
CLOUDINARY_URL=""
# ...or the three parts:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ---- Optional ----------------------------------------------------------
# Online card payments (Stripe Checkout). Leave empty to offer cash on delivery only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Social sign-in (credentials sign-in works without these)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only for `npm run db:seed` (never used by the running app)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
